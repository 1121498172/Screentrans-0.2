<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="屏幕翻译"
            android:textColor="?attr/colorOnSurface"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Discord 优先 · 离线秒出 + LLM 精修"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <!-- 使用步骤 -->
        <TextView
            style="@style/SectionTitle"
            android:text="使用步骤" />

        <TextView
            android:id="@+id/tvSteps"
            style="@style/HintText"
            android:text="1. 若无法开启无障碍：设置 → 应用管理 → 屏幕翻译 → 右上角 ⋮ → 允许受限设置\n2. 打开「无障碍」→ 已下载的应用 → 屏幕翻译 → 开启\n3. 填入 API Key 后点「测试连接」\n4. 打开下方总开关，再切到 Discord\n5. HyperOS 建议：应用信息 → 省电策略 → 无限制，并在最近任务里锁定本应用" />

        <!-- 权限与开关 -->
        <TextView
            style="@style/SectionTitle"
            android:text="权限与开关" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvA11yStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="无障碍服务：未开启"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnA11y"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="去开启无障碍" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="翻译总开关"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvSwitchHint"
                    style="@style/HintText"
                    android:layout_marginTop="6dp"
                    android:text="开关打开后，进入白名单应用会自动翻译；也可下拉快捷设置里添加「屏幕翻译」磁贴。" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 翻译引擎 -->
        <TextView
            style="@style/SectionTitle"
            android:text="翻译引擎" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbHybrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="离线先出 + LLM 精修（推荐）" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbOffline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅离线（免费、快、质量一般）" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLlm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仅 LLM（质量最好，有 0.5–2 秒延迟）" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="下载 / 检查离线模型" />

        <TextView
            android:id="@+id/tvModel"
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="离线模型约 30MB，需要能访问 Google 的网络环境；失败也不影响 LLM 模式。" />

        <!-- LLM 配置 -->
        <TextView
            style="@style/SectionTitle"
            android:text="LLM 设置" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="接口地址（OpenAI 兼容）"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBaseUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="API Key"
            app:boxBackgroundMode="outline"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="模型名称"
            app:boxBackgroundMode="outline">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTest"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="测试连接" />

        <TextView
            android:id="@+id/tvTest"
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="点「测试连接」会翻译一句游戏黑话，用来验证 Key 是否可用。" />

        <TextView
            android:id="@+id/tvLastError"
            style="@style/HintText"
            android:layout_marginTop="6dp"
            android:text="LLM 状态：未记录到错误" />

        <!-- 外观 -->
        <TextView
            style="@style/SectionTitle"
            android:text="外观" />

        <TextView
            android:id="@+id/tvFont"
            style="@style/HintText"
            android:text="字号缩放：100%" />

        <SeekBar
            android:id="@+id/sbFont"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/tvAlpha"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:text="背景不透明度：96%" />

        <SeekBar
            android:id="@+id/sbAlpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="175" />

        <TextView
            android:id="@+id/tvOffset"
            style="@style/HintText"
            android:layout_marginTop="10dp"
            android:text="纵向微调：0 dp（若整屏译文整体偏上/偏下再动它）" />

        <SeekBar
            android:id="@+id/sbOffset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            style="@style/HintText"
            android:layout_marginTop="12dp"
            android:text="覆盖层配色" />

        <RadioGroup
            android:id="@+id/rgTheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随系统" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="深色" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="浅色" />
        </RadioGroup>

        <!-- 生效应用 -->
        <TextView
            style="@style/SectionTitle"
            android:text="生效应用" />

        <TextView
            android:id="@+id/tvWhitelist"
            style="@style/HintText"
            android:text="com.discord" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhitelist"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选择应用" />

        <!-- 术语表 -->
        <TextView
            style="@style/SectionTitle"
            android:text="自定义术语表" />

        <TextView
            android:id="@+id/tvGlossary"
            style="@style/HintText"
            android:text="内置了 Discord / Patreon / 游戏常用译法。这里可以追加你自己的，一行一条：english=中文" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGlossary"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="编辑术语表" />

        <!-- 缓存 -->
        <TextView
            style="@style/SectionTitle"
            android:text="缓存" />

        <TextView
            android:id="@+id/tvCache"
            style="@style/HintText"
            android:text="已缓存 0 条译文" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearCache"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="清空翻译缓存" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiag"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看抓取诊断" />

        <TextView
            android:id="@+id/tvDiagHint"
            style="@style/HintText"
            android:text="怀疑漏翻时：打开 Discord 停 3 秒 → 回这里点「查看抓取诊断」，会列出每条消息是没抓到、没翻出来，还是画出来了。" />

        <TextView
            style="@style/HintText"
            android:layout_marginTop="26dp"
            android:text="隐私说明：本应用只读取你在白名单里勾选的应用界面文本，自动跳过密码框和输入框；API Key 仅保存在本机，翻译请求直接发往你填写的接口地址。" />
    </LinearLayout>
</ScrollView>
